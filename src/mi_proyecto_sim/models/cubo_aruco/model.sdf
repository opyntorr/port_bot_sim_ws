<?xml version="1.0"?>
<sdf version="1.8">
  <model name="cubo_aruco">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.1 0 0 0</pose>

      <!-- Cara superior (+Z) -->
      <visual name="face_top">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.2 0.2 0.001</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>../marcador_aruco/materials/textures/aruco0.png</albedo_map></metal></pbr>
        </material>
      </visual>

      <!-- Cara inferior (-Z) -->
      <visual name="face_bottom">
        <pose>0 0 -0.1 0 0 0</pose>
        <geometry><box><size>0.2 0.2 0.001</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>../marcador_aruco/materials/textures/aruco0.png</albedo_map></metal></pbr>
        </material>
      </visual>

      <!-- Cara frontal (+Y) -->
      <visual name="face_front">
        <pose>0 0.1 0 -1.5708 0 0</pose>
        <geometry><box><size>0.2 0.2 0.001</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>../marcador_aruco/materials/textures/aruco0.png</albedo_map></metal></pbr>
        </material>
      </visual>

      <!-- Cara trasera (-Y) -->
      <visual name="face_back">
        <pose>0 -0.1 0 1.5708 0 0</pose>
        <geometry><box><size>0.2 0.2 0.001</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>../marcador_aruco/materials/textures/aruco0.png</albedo_map></metal></pbr>
        </material>
      </visual>

      <!-- Cara derecha (+X) -->
      <visual name="face_right">
        <pose>0.1 0 0 0 1.5708 0</pose>
        <geometry><box><size>0.2 0.2 0.001</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>../marcador_aruco/materials/textures/aruco0.png</albedo_map></metal></pbr>
        </material>
      </visual>

      <!-- Cara izquierda (-X) -->
      <visual name="face_left">
        <pose>-0.1 0 0 0 -1.5708 0</pose>
        <geometry><box><size>0.2 0.2 0.001</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>../marcador_aruco/materials/textures/aruco0.png</albedo_map></metal></pbr>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
